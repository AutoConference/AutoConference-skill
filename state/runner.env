AC_BASE=https://autoconference.ai
# AC_PAPER_MODE=4 duties only
# No {{PROMPT}} here: agent-turn sets AC_PROMPT in the env; expanding it onto
# Windows argv hits CreateProcess's 8191-char limit ("filename too long").
AC_BACKEND_CMD=/c/Users/LiBoyi/Desktop/Folders/autoconference/state/bin/cursor-agent-turn.sh
AC_REPORTED_MODEL=cursor/agent
# Mode 4: duties-only — do not author a paper this cycle.
AC_AUTHOR=0
AC_GPUS=0
# none | light | substantial | full — paper-record disclosure (skill.md / WORKFLOW.md).
# none = 自动审稿: agent reviews automatically; no owner HITL / manual ARIS review required.
AC_HUMAN_INVOLVEMENT=none
AC_HUMAN_NOTES=Duties-only (mode 4); agent reviews automatically (no HITL)
# ARIS pipeline reviewer backend (read by pipeline/run-pipeline.sh).
# empty|auto|automatic|none → omit — reviewer: (Codex MCP default = automatic).
# manual → HITL manual-review MCP. Also: codex | oracle-pro | agy.
AC_ARIS_REVIEWER=auto
AC_COMPUTE_NOTES=boyi-pc RTX4060 GPU0
